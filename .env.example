# ============================================================
# TRUTHLENS — ENVIRONMENT VARIABLES
# Copy to .env and fill in your credentials
# ============================================================

# --- Core API ---
API_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///truthlens.db

# --- Models ---
MODEL_DIR=./models
ENABLE_GPU=false

# ============================================================
# INTEGRATION CREDENTIALS
# Only fill in what you plan to use
# ============================================================

# --- Chrome Extension ---
# No credentials needed — just set API_URL in popup.js

# --- Telegram Bot ---
# 1. Talk to @BotFather on Telegram
# 2. Send /newbot → follow instructions
# 3. Copy the token
TL_TELEGRAM_TOKEN=

# --- WhatsApp Bot (Twilio) ---
# 1. Sign up at https://www.twilio.com
# 2. Get a phone number with WhatsApp enabled
# 3. Copy credentials from console
TWILIO_SID=
TWILIO_AUTH=
TWILIO_WHATSAPP=+14155238886  # Twilio sandbox number

# --- Slack Bot ---
# 1. Go to https://api.slack.com/apps
# 2. Create New App → Event Subscriptions
# 3. Subscribe to: message.channels, message.im
# 4. Add Bot Scopes: chat:write, files:read
# 5. Install to workspace
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-  # For Socket Mode (optional)

# --- Discord Bot ---
# 1. Go to https://discord.com/developers/applications
# 2. Create Application → Bot → Add Bot
# 3. Enable: MESSAGE CONTENT INTENT
# 4. OAuth2 → URL Generator → Scopes: bot
# 5. Bot Permissions: Send Messages, Read Message History
# 6. Copy invite URL → add to your server
DISCORD_TOKEN=

# --- Twitter/X Bot ---
# 1. Go to https://developer.twitter.com
# 2. Create Project + App
# 3. Enable: Read + Write permissions
# 4. Generate all keys
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# --- Email Plugin (IMAP) ---
# For reading emails directly from your inbox
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password  # Gmail: use App Password, not regular password

# --- WordPress Plugin ---
# Set in WordPress admin → Settings → TruthLens
# Or set here for API access
WORDPRESS_API_KEY=

# ============================================================
# FEATURE FLAGS
# ============================================================

ENABLE_PROVENANCE=false
ENABLE_FACTCHECK=false
ENABLE_OCR=true
ENABLE_SOURCE_ANALYSIS=true
ENABLE_REVIEW_QUEUE=true
ENABLE_INVESTIGATION=true
