# TruthLens — Environment Configuration

# === CORE ===
DATABASE_URL=sqlite+aiosqlite:///./truthlens.db
MODEL_DIR=./models
ENVIRONMENT=development

# === SECURITY ===
TL_SECRET_KEY=change-me-to-a-random-32-char-string
TL_ADMIN_API_KEY=your-admin-api-key-here

# === FILE LIMITS ===
TL_MAX_FILE_MB=100
TL_MAX_VIDEO_S=300
TL_MAX_AUDIO_S=300

# === DATA RETENTION (days) ===
TL_RETENTION_MEDIA=1
TL_RETENTION_META=30
TL_RETENTION_REPORTS=30
TL_RETENTION_AUDIT=90

# === TOKEN EXPIRY ===
TL_TOKEN_EXPIRY=86400

# === WHATSAPP (optional) ===
TL_WHATSAPP_TOKEN=
TL_WHATSAPP_PHONE_ID=

# === TELEGRAM (optional) ===
TL_TELEGRAM_TOKEN=

# === PAGERDUTY (optional) ===
PD_ROUTING_KEY=

# === FEATURE FLAGS ===
TL_INVESTIGATION_MODE=true
TL_EVIDENCE_ENGINE=true
TL_AUDIT_TRAIL=true
TL_MODEL_VERSIONS=true
TL_CONTRADICTION=true
TL_VIDEO_TIMELINE=true
TL_EXPLANATION=true
TL_CASE_MGMT=true
TL_HUMAN_REVIEW=true
TL_SCREENSHOT=true
TL_CLAIMS=true
TL_PERF_MONITOR=true
TL_OCR=true
TL_EXIF=true
TL_CREDIBILITY=true
TL_ENSEMBLE=true
TL_UNCERTAINTY=true
TL_CONSISTENCY_CHECK=true
TL_EVIDENCE_QUALITY=true
TL_COUNTERFACTUALS=true
TL_SECURE_SANDBOX=true
TL_PRIVACY_MODE=true
TL_DATA_RETENTION=true
TL_SMART_CACHE=true
TL_SIMILARITY=true
TL_ASYNC_ANALYSIS=true
TL_RED_TEAM=true
TL_DRIFT_MONITORING=true
TL_MODEL_CHALLENGER=true
TL_OBSERVABILITY=true
TL_GOLDEN_TESTS=true
TL_EVIDENCE_CHAIN=true
TL_REPRODUCIBILITY=true
TL_CONFLICT_RESOLUTION=true
TL_ANNOTATIONS=true
TL_INVESTIGATION_COPILOT=true
TL_INTEGRITY_SCORE=true
TL_INV_CONFIDENCE=true
